{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.blocks.size > 0
    assign announcement_bar = true
  endif
  assign display_style = section.settings.display_style | default: 'slider'
  assign use_gradient = section.settings.use_gradient
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

<style>
  .announcement-bar-icon {
    display: inline-block;
    margin-inline-end: 0.5rem;
    line-height: 1;
    transform: translateY(0.05em);
  }

  .utility-bar--gradient {
    background: linear-gradient(90deg, var(--announcement-gradient-1), var(--announcement-gradient-2)) !important;
  }
  .utility-bar--gradient .announcement-bar__message,
  .utility-bar--gradient .announcement-bar__message span,
  .utility-bar--gradient .announcement-bar__link,
  .utility-bar--gradient .announcement-marquee__item,
  .utility-bar--gradient .announcement-marquee__item span,
  .utility-bar--gradient .announcement-marquee__divider {
    color: var(--announcement-text-color) !important;
  }
  .utility-bar--gradient .icon-arrow path,
  .utility-bar--gradient .icon-arrow polyline,
  .utility-bar--gradient .icon-arrow line {
    stroke: var(--announcement-text-color) !important;
  }

  .announcement-marquee {
    overflow: hidden;
    width: 100%;
  }
  .announcement-marquee__track {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    animation: announcement-marquee-scroll var(--marquee-duration, 3s) linear infinite;
    will-change: transform;
  }
  .announcement-marquee:hover .announcement-marquee__track,
  .announcement-marquee:focus-within .announcement-marquee__track {
    animation-play-state: paused;
  }
  .announcement-marquee__item {
    display: inline-flex;
    align-items: center;
    padding: 0 0.5rem;
  }
  .announcement-marquee__item a {
    color: inherit;
    text-decoration: none;
  }
  .announcement-marquee__item a:hover {
    text-decoration: underline;
  }
  .announcement-marquee__divider {
    opacity: 0.5;
    margin: 0 1.25rem;
  }
  @keyframes announcement-marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .announcement-marquee__track {
      animation: none;
    }
  }

  /* Fade in/out animation for slider */
  @keyframes fadeInOut {
    0%, 100% {
      opacity: 0;
    }
    10%, 90% {
      opacity: 1;
    }
  }

  .announcement-bar__message {
    animation: fadeInOut 3s ease-in-out;
  }

  .slideshow__slide {
    animation: fadeInOut 3s ease-in-out !important;
  }
</style>

<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}{% if use_gradient %} utility-bar--gradient{% endif %}"
  {% if use_gradient %}
    style="--announcement-gradient-1: {{ section.settings.gradient_color_1 }}; --announcement-gradient-2: {{ section.settings.gradient_color_2 }}; --announcement-text-color: {{ section.settings.gradient_text_color }};"
  {% endif %}
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}

    {%- if display_style == 'marquee' and section.blocks.size > 0 -%}
      <div
        class="announcement-marquee"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        style="--marquee-duration: {{ section.settings.marquee_speed }}s;"
      >
        <div class="announcement-marquee__track">
          {%- for block in section.blocks -%}
            <span class="announcement-marquee__item h5" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="announcement-bar-icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="link link--text">
              {%- endif -%}
              <span>{{ block.settings.text | escape }}</span>
              {%- if block.settings.link != blank -%}
                </a>
              {%- endif -%}
            </span>
            {%- unless forloop.last -%}
              <span class="announcement-marquee__divider" aria-hidden="true">•</span>
            {%- endunless -%}
          {%- endfor -%}
          <span class="announcement-marquee__divider" aria-hidden="true">•</span>
          <span aria-hidden="true" style="display: inline-flex; align-items: center;">
            {%- for block in section.blocks -%}
              <span class="announcement-marquee__item h5">
                {%- if block.settings.icon != blank -%}
                  <span class="announcement-bar-icon">{{ block.settings.icon }}</span>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="link link--text" tabindex="-1">
                {%- endif -%}
                <span>{{ block.settings.text | escape }}</span>
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </span>
              {%- unless forloop.last -%}
                <span class="announcement-marquee__divider">•</span>
              {%- endunless -%}
            {%- endfor -%}
          </span>
        </div>
      </div>
    {%- elsif section.blocks.size == 1 -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ section.blocks.first.shopify_attributes }}
      >
        {%- if section.blocks.first.settings.text != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message h5">
            {%- if section.blocks.first.settings.icon != blank -%}
              <span class="announcement-bar-icon" aria-hidden="true">{{ section.blocks.first.settings.icon }}</span>
            {%- endif -%}
            <span>{{ section.blocks.first.settings.text | escape }}</span>
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- elsif section.blocks.size > 1 -%}
      <slideshow-component
        class="announcement-bar"
        role="region"
        aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
        aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
      >
        <div class="announcement-bar-slider slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div
            class="grid grid--1-col slider slider--everywhere"
            id="Slider-{{ section.id }}"
            aria-live="polite"
            aria-atomic="true"
            data-autoplay="true"
            data-speed="3"
          >
            {%- for block in section.blocks -%}
              <div
                class="slideshow__slide slider__slide grid__item grid--1-col"
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
                role="group"
                aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                tabindex="-1"
              >
                <div
                  class="announcement-bar__announcement"
                  role="region"
                  aria-label="{{ 'sections.header.announcement' | t }}"
                >
                  {%- if block.settings.text != blank -%}
                    {%- if block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="announcement-bar__link link link--text focus-inset animate-arrow"
                      >
                    {%- endif -%}
                    <p class="announcement-bar__message h5">
                      {%- if block.settings.icon != blank -%}
                        <span class="announcement-bar-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                      {%- endif -%}
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if block.settings.link != blank -%}
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      {%- endif -%}
                    </p>
                    {%- if block.settings.link != blank -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.announcements.next_announcement' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
        <style>
          /* theme editor power preview fix */
          .announcement-bar-slider .slider__slide[aria-hidden='true'] {
            visibility: hidden;
          }
        </style>
      {%- endif -%}
    {%- endif -%}

    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 3,
      "step": 1,
      "unit": "s",
      "label": "Change text every 3 seconds",
      "default": 3
    },
    {
      "type": "select",
      "id": "display_style",
      "label": "Display style",
      "options": [
        { "value": "slider", "label": "Slider (one message at a time)" },
        { "value": "marquee", "label": "Scrolling ticker" }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Ticker speed (higher is slower)",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "Gradient background"
    },
    {
      "type": "checkbox",
      "id": "use_gradient",
      "label": "Use a custom gradient background",
      "default": false
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient color 1",
      "default": "#FF6EC7"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient color 2",
      "default": "#7873F5"
    },
    {
      "type": "color",
      "id": "gradient_text_color",
      "label": "Text color on gradient",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.announcement-bar.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon or emoji",
          "info": "Optional. Shown before the message, e.g. 🚚 or 🔥"
        },
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "✨",
            "text": "Welcome to HeerMart, where quality comes first"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "🚚",
            "text": "Free shipping across India on orders over ₹999"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "🔥",
            "text": "Flat 20% off, this week only"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "🆕",
            "text": "New arrivals every Friday"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "💬",
            "text": "Questions? Chat with us anytime"
          }
        }
      ]
    }
  ]
}
{% endschema %}